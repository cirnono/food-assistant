title: 厨房
path: kitchen
icon: mdi:chef-hat
cards:
  - type: conditional
    conditions:
      - condition: state
        entity: sensor.food_assistant
        state_not: unavailable
      - condition: state
        entity: sensor.food_assistant_cooking
        state: idle
      - condition: state
        entity: sensor.food_assistant_recipe
        state_not: 暂无推荐
    card:
      type: vertical-stack
      cards:
        - type: markdown
          title: 今日推荐
          content: >-
            ## {{ states('sensor.food_assistant_recipe') }}

            覆盖率：{{ states('sensor.food_assistant_recipe_coverage') }}%

            缺少：{{ states('sensor.food_assistant_recipe_missing') or '无' }}

            临期：{{ state_attr('sensor.food_assistant_recipe', 'expiring') | default([]) | join('、') or '无' }}

            预计时间：{{ state_attr('sensor.food_assistant_recipe', 'total_time') | default('未知') }} 分钟

            [打开 Mealie]({{ states('sensor.food_assistant_recipe_url') }}) ·
            [管理库存]({{ state_attr('sensor.food_assistant', 'links').pantry }}) ·
            [查看全部推荐]({{ state_attr('sensor.food_assistant', 'links').recommendations }})
        - type: grid
          columns: 4
          square: false
          cards:
            - type: button
              name: 换一道
              icon: mdi:shuffle-variant
              tap_action: &next_recipe_action
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_next_recipe}
            - type: button
              name: 开始做饭
              icon: mdi:chef-hat
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_start_cooking}
            - type: button
              name: 标记今天做了
              icon: mdi:pot-steam
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_mark_cooked}
                confirmation: {text: 确认将当前推荐标记为今天做过？}
            - type: button
              name: 刷新
              icon: mdi:refresh
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_refresh}
        - type: glance
          title: 库存概览
          columns: 4
          entities:
            - {entity: sensor.food_assistant_inventory_total, name: 总库存}
            - {entity: sensor.food_assistant_expiring, name: 临期}
            - {entity: sensor.food_assistant_expired, name: 过期}
            - {entity: sensor.food_assistant_out_of_stock, name: 缺货}
  - type: conditional
    conditions:
      - condition: state
        entity: sensor.food_assistant
        state_not: unavailable
      - condition: state
        entity: sensor.food_assistant_cooking
        state: active
    card:
      type: vertical-stack
      cards:
        - type: markdown
          title: 正在烹饪
          content: >-
            ## {{ states('sensor.food_assistant_cooking_recipe') }}

            当前步骤 {{ states('sensor.food_assistant_cooking_step') }} / {{ state_attr('sensor.food_assistant_cooking_step', 'total') }}

            **{{ state_attr('sensor.food_assistant_cooking_step', 'text') }}**

            进度：{{ states('sensor.food_assistant_cooking_progress') }}%

            下一个计时器：{{ states('sensor.food_assistant_next_timer') }}（{{ states('sensor.food_assistant_next_timer_remaining') }} 秒）

            最近结束的计时器：{{ states('sensor.food_assistant_recent_timer') }}

            [继续分步烹饪]({{ states('sensor.food_assistant_cooking_url') }})
        - type: gauge
          entity: sensor.food_assistant_cooking_progress
          name: 烹饪进度
          min: 0
          max: 100
        - type: grid
          columns: 4
          square: false
          cards:
            - type: button
              name: 上一步
              icon: mdi:arrow-left
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_previous_step}
            - type: button
              name: 下一步
              icon: mdi:arrow-right
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_next_step}
            - type: button
              name: 完成烹饪
              icon: mdi:check-circle
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_finish_cooking}
                confirmation: {text: 确认完成烹饪并写入做饭历史？}
            - type: button
              name: 取消烹饪
              icon: mdi:cancel
              tap_action:
                action: perform-action
                perform_action: script.turn_on
                target: {entity_id: script.food_assistant_cancel_cooking}
                confirmation: {text: 确认取消本次烹饪？}
  - type: conditional
    conditions:
      - condition: state
        entity: sensor.food_assistant
        state_not: unavailable
      - condition: state
        entity: sensor.food_assistant_cooking
        state: idle
      - condition: state
        entity: sensor.food_assistant_recipe
        state: 暂无推荐
    card:
      type: markdown
      content: 暂无符合条件的推荐，请检查库存或放宽筛选条件。
  - type: conditional
    conditions:
      - condition: state
        entity: sensor.food_assistant
        state: unavailable
    card:
      type: markdown
      content: Food Assistant 当前不可用，请检查网络、服务状态和 Home Assistant 日志。
  - type: conditional
    conditions:
      - condition: state
        entity: sensor.food_assistant
        state_not: unavailable
      - condition: state
        entity: sensor.food_assistant_cooking
        state: unavailable
    card:
      type: markdown
      content: 烹饪状态暂时不可用，请检查 active-state REST sensor 配置。
