# Application
APP_VERSION=0.24.0
APP_UID=1000
APP_GID=1000
TZ=UTC
FOOD_ASSISTANT_DATA_DIR=./data
DATABASE_URL=sqlite:////data/food-assistant.db
FOOD_ASSISTANT_API_TOKEN=
FOOD_ASSISTANT_API_TOKEN_FILE=
FOOD_ASSISTANT_API_TOKEN_HOST_FILE=

# Mealie
MEALIE_BASE_URL=http://host.docker.internal:9925
MEALIE_TOKEN=
MEALIE_TOKEN_FILE=
MEALIE_TOKEN_HOST_FILE=
MEALIE_TIMEOUT_SECONDS=90
MEALIE_CONNECT_TIMEOUT_SECONDS=5
MEALIE_WRITE_TIMEOUT_SECONDS=10
MEALIE_POOL_TIMEOUT_SECONDS=10
MEALIE_RECOMMENDATION_CONCURRENCY=8
MEALIE_RECIPE_CACHE_TTL_SECONDS=21600
# Optional public Home Assistant kitchen dashboard URL shown by /cook.
HOME_ASSISTANT_KITCHEN_URL=

# LLM provider
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_API_KEY_HOST_FILE=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=300
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_CONTEXT_LENGTH=6144
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_KEEP_ALIVE=10m
LLM_UNLOAD_AFTER_BATCH=true

# OpenAI-compatible example (replace the LLM values above):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# LLM_MODEL=example-model

# Legacy Ollama variables remain supported when corresponding LLM_* values
# are unset. New deployments should use LLM_* variables.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_NUM_CTX=6144
# OLLAMA_KEEP_ALIVE=10m
